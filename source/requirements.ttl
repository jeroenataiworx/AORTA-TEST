<urn:researchmaster:aorta:as:req:XIS.SVD.e4020> a rm:Requirement ;
  dcterms:identifier "XIS.SVD.e4020" ;
  dcterms:title "Gebruik Supportal" ;
  ea:alias "XIS.SVD.e4020" ;
  dcterms:description "; De XIS-leverancier moet voor in gebruik name van een applicatie in productie, het XIS-aanspreekpunt en contactgegevens beschikbaar gesteld hebben via Supportal. ;" .

<urn:researchmaster:aorta:as:req:XIS.SVD.e4030> a rm:Requirement ;
  dcterms:identifier "XIS.SVD.e4030" ;
  dcterms:title "Inrichten XIS-servicedesk" ;
  ea:alias "XIS.SVD.e4030" ;
  dcterms:description "; De XIS-leverancier moet een 'XIS-servicedesk' inrichten die als aanspreekpunt fungeert voor problemen m.b.t. het XIS. De XIS-servicedesk moet onderdeel uitmaken van het ketenbeheerproces. ;" .
